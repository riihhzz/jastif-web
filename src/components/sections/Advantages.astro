---
import Icon from '@/components/ui/Icon.astro';
import Sticker from '@/components/ui/Sticker.astro';
import { advantages } from '@/data/services';

const tilts = ['-rotate-3', 'rotate-2', '-rotate-2', 'rotate-3'];
---

<!--
  Headline raksasa tetap di tengah, kartu kaca melintas dari kanan ke kiri satu per satu
  sambil berputar (lihat initAdvantages di scroll-scenes.ts).
-->
<Sticker
  id="keunggulan"
  length={420}
  data-advantages
  class="bg-brand-blue-950"
  trackClass="flex flex-col justify-center overflow-hidden py-24 motion-on:py-0"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_50%_at_50%_45%,rgb(43_149_255/0.35),transparent_70%)]"
  ></div>

  <h2 class="relative text-center text-mega text-[clamp(3.5rem,13vw,12rem)]" data-advantages-title>
    <span class="block overflow-clip">
      <span class="block" data-line>
        Kualitas Studio
      </span>
    </span>
    <span class="block overflow-clip text-brand-orange-500">
      <span class="block" data-line>
        Tanpa Studio
      </span>
    </span>
  </h2>

  <ul class="container-page relative mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 motion-on:absolute motion-on:inset-0 motion-on:mt-0 motion-on:max-w-none motion-on:place-items-center motion-on:gap-0 motion-on:sm:grid-cols-1 motion-on:lg:grid-cols-1">
    {advantages.map((item, i) => (
      <li
        data-advantage-card
        class:list={[
          'glass flex aspect-[4/5] w-full flex-col rounded-[2rem] bg-gradient-to-br from-white/25 via-brand-blue-500/20 to-brand-orange-500/25 p-7 shadow-2xl shadow-black/30 motion-on:col-start-1 motion-on:row-start-1 motion-on:w-[min(78vw,21rem)]',
          tilts[i % tilts.length],
        ]}
      >
        <span class="inline-flex w-fit rounded-full bg-white/15 px-3 py-1 font-display text-xs font-bold tracking-widest uppercase">
          {item.label}
        </span>
        <span class="mt-auto grid size-16 place-items-center rounded-2xl bg-brand-orange-500 shadow-lg shadow-brand-orange-600/40">
          <Icon name="cube" class="size-8" />
        </span>
        <h3 class="mt-6 text-mega text-5xl">{item.title}</h3>
        <p class="mt-3 leading-relaxed text-white/80">{item.description}</p>
      </li>
    ))}
  </ul>
</Sticker>
