---
import Blob from '@/components/ui/Blob.astro';
import { pipeline } from '@/data/services';
---

<!--
  Scrollytelling: di desktop section di-pin dan kartu bergeser horizontal mengikuti scroll
  (lihat initPipeline di scripts/animations/scroll-scenes.ts). Di mobile tampil vertikal.
-->
<section id="konsep" class="relative isolate overflow-hidden bg-brand-blue-950" data-pipeline>
  <Blob color="blue" speed={0.3} class="top-10 -left-40 size-[36rem] opacity-50" />
  <Blob color="orange" speed={0.5} class="-right-32 bottom-0 size-[28rem] opacity-30" />

  <div class="flex min-h-svh flex-col justify-center py-24 lg:py-0">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
        <div data-reveal class="max-w-2xl">
          <p class="mb-4 inline-flex items-center gap-2 font-display text-xs font-bold tracking-[0.2em] text-brand-blue-300 uppercase">
            <span class="size-2 rounded-sm bg-brand-orange-500"></span>
            Konsep Kami
          </p>
          <h2 class="text-3xl leading-[1.1] font-extrabold sm:text-4xl lg:text-5xl">
            One Product <span class="text-accent">→</span> One Digital Asset{' '}
            <span class="text-accent">→</span> Many Contents
          </h2>
        </div>
        <p data-reveal class="max-w-sm leading-relaxed text-white/70">
          Produkmu kami ubah menjadi aset 3D yang bisa terus dipakai ulang. Satu kali modeling,
          banyak konten promosi.
        </p>
      </div>

      <div class="mt-10 h-1 overflow-hidden rounded-full bg-white/10 max-lg:hidden">
        <div
          class="h-full w-full origin-left scale-x-0 bg-brand-orange-500"
          data-pipeline-progress
        ></div>
      </div>
    </div>

    <div class="mt-10 lg:mt-12 lg:overflow-visible">
      <ol
        class="container-page flex flex-col gap-5 lg:w-max lg:max-w-none lg:flex-row lg:gap-6 lg:pr-[10vw]"
        data-pipeline-track
      >
        {pipeline.map((step, i) => (
          <li
            data-reveal
            class="glass group relative flex flex-col overflow-hidden rounded-[1.75rem] p-7 lg:h-[24rem] lg:w-[22rem] lg:p-8"
          >
            <span
              class="pointer-events-none absolute -top-6 -right-2 font-display text-[9rem] leading-none font-black text-white/[0.06] transition group-hover:text-brand-orange-500/20"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="grid size-12 place-items-center rounded-2xl bg-brand-orange-500 font-display text-lg font-extrabold">
              {i + 1}
            </span>
            <h3 class="mt-6 text-2xl font-extrabold lg:mt-auto">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-white/70">{step.description}</p>
            <p class="mt-6 inline-flex w-fit rounded-full bg-white/10 px-3 py-1 text-xs font-bold text-brand-blue-100">
              Hasil: {step.output}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
