---
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { faq } from '@/data/faq';
---

<section id="faq" class="relative bg-brand-blue-50 py-24 text-ink lg:py-32">
  <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.5fr]">
    <SectionHeading eyebrow="FAQ" tone="dark" class="lg:sticky lg:top-28 lg:self-start">
      Pertanyaan yang Sering <span class="text-brand-blue-600">Ditanyakan</span>
      <Fragment slot="description">
        Masih ada yang ingin ditanyakan? Langsung chat kami di WhatsApp.
      </Fragment>
    </SectionHeading>

    <div class="space-y-3">
      {faq.map((item, i) => (
        <details
          data-reveal
          name="faq"
          open={i === 0}
          class="group rounded-3xl bg-white p-6 shadow-sm shadow-brand-blue-900/5 transition open:shadow-xl open:shadow-brand-blue-900/10"
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display font-bold [&::-webkit-details-marker]:hidden">
            {item.q}
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-brand-blue-50 text-brand-blue-600 transition duration-300 group-open:rotate-45 group-open:bg-brand-orange-500 group-open:text-white">
              <Icon name="plus" class="size-4" />
            </span>
          </summary>
          <p class="mt-4 pr-12 leading-relaxed text-ink/65">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
