---
import ImageSlot from '@/components/ui/ImageSlot.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { categories, portfolio } from '@/data/portfolio';

const filters = ['Semua', ...categories];
const tones = ['blue', 'orange', 'light'] as const;
---

<section id="portofolio" class="relative bg-brand-blue-50 py-24 text-ink lg:py-32">
  <div class="container-page">
    <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
      <SectionHeading eyebrow="Portofolio" tone="dark">
        Karya & <span class="text-brand-blue-600">Prototype</span> Kami
        <Fragment slot="description">
          Contoh visual produk yang sedang kami kembangkan. Galeri ini akan terus bertambah.
        </Fragment>
      </SectionHeading>

      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter kategori" data-reveal>
        {filters.map((f, i) => (
          <button
            type="button"
            data-filter={f}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="rounded-full border border-ink/10 bg-white px-4 py-2 font-display text-sm font-bold text-ink/70 transition hover:border-brand-blue-500 aria-pressed:border-brand-blue-600 aria-pressed:bg-brand-blue-600 aria-pressed:text-white"
          >
            {f}
          </button>
        ))}
      </div>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-portfolio-grid>
      {portfolio.map((item, i) => (
        <li data-category={item.category} data-reveal class="group">
          <ImageSlot
            src={item.image}
            alt={item.title}
            tone={tones[i % tones.length]}
            class="aspect-[4/5] rounded-[1.5rem] transition duration-700 ease-out-expo group-hover:-translate-y-1 group-hover:shadow-2xl group-hover:shadow-brand-blue-900/20"
          >
            <div class="absolute inset-x-3 bottom-3 flex items-center justify-between rounded-2xl bg-white/90 px-4 py-3 backdrop-blur">
              <p class="font-display text-sm font-bold">{item.title}</p>
              <span class="rounded-full bg-brand-blue-50 px-2.5 py-1 text-[0.7rem] font-bold text-brand-blue-700">
                {item.category}
              </span>
            </div>
          </ImageSlot>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-portfolio-grid] > li');

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((item) => {
        item.hidden = filter !== 'Semua' && item.dataset.category !== filter;
      });
      window.dispatchEvent(new Event('layout:change'));
    }),
  );
</script>
