---
import ImageSlot from '@/components/ui/ImageSlot.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { beforeAfter } from '@/data/portfolio';

const comparison = [
  {
    label: 'Foto studio konvensional',
    items: ['Sewa studio & kamera', 'Lighting & properti fisik', 'Foto ulang untuk tiap konten'],
  },
  {
    label: 'Visual 3D Jastif.id',
    items: [
      'Cukup kirim foto dari HP',
      'Lighting & latar digital',
      'Aset dipakai ulang untuk konten baru',
    ],
  },
];
---

<section class="relative bg-white py-24 text-ink lg:py-32">
  <div class="container-page grid items-center gap-14 lg:grid-cols-2">
    <div>
      <SectionHeading eyebrow="Before / After" tone="dark">
        Dari Foto HP Menjadi <span class="text-brand-orange-500">Visual 3D</span>
        <Fragment slot="description">
          Geser untuk membandingkan foto produk biasa dengan hasil render 3D. Tanpa studio, tanpa
          kamera mahal.
        </Fragment>
      </SectionHeading>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {comparison.map((col, i) => (
          <div
            data-reveal
            class:list={[
              'rounded-3xl p-6',
              i === 0 ? 'bg-brand-blue-50' : 'bg-brand-blue-600 text-white',
            ]}
          >
            <h3 class="font-display text-sm font-extrabold">{col.label}</h3>
            <ul class="mt-4 space-y-2.5 text-sm">
              {col.items.map((item) => (
                <li class="flex gap-2.5">
                  <span
                    class:list={[
                      'mt-1.5 size-2 shrink-0 rounded-full',
                      i === 0 ? 'bg-ink/30' : 'bg-brand-orange-400',
                    ]}
                  />
                  <span class={i === 0 ? 'text-ink/70' : 'text-white/90'}>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div
      data-reveal
      data-compare
      class="relative aspect-[4/5] touch-pan-y overflow-hidden rounded-[2rem] shadow-2xl shadow-brand-blue-900/20 select-none"
      style="--pos: 50%"
    >
      <ImageSlot
        src={beforeAfter.after}
        alt={`${beforeAfter.title}, hasil render 3D`}
        label="Render 3D"
        tone="blue"
        labelAlign="right"
        class="absolute inset-0"
      />
      <div class="absolute inset-0 [clip-path:inset(0_calc(100%-var(--pos))_0_0)]">
        <ImageSlot
          src={beforeAfter.before}
          alt={`${beforeAfter.title}, foto asli`}
          label="Foto asli dari HP"
          tone="light"
          labelAlign="left"
          class="absolute inset-0"
        />
      </div>

      <span class="glass absolute top-4 left-4 rounded-full px-3 py-1 text-xs font-bold text-ink">
        Sebelum
      </span>
      <span class="absolute top-4 right-4 rounded-full bg-brand-orange-500 px-3 py-1 text-xs font-bold text-white">
        Sesudah
      </span>

      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-y-0 left-[var(--pos)] w-1 -translate-x-1/2 bg-white shadow-[0_0_20px_rgb(0_0_0/0.3)]"
      >
        <span class="absolute top-1/2 left-1/2 grid size-12 -translate-1/2 place-items-center rounded-full bg-white text-ink shadow-xl">
          <svg
            viewBox="0 0 24 24"
            class="size-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 6-6 6 6 6M15 6l6 6-6 6" />
          </svg>
        </span>
      </div>

      <input
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label="Geser untuk membandingkan sebelum dan sesudah"
        class="absolute inset-0 size-full cursor-ew-resize opacity-0"
        data-compare-input
      />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-compare-input]')!;
    input.addEventListener('input', () => root.style.setProperty('--pos', `${input.value}%`));
  });
</script>
