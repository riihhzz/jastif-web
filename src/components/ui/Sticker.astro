---
/**
 * Section "sticker": wrapper setinggi `length` (dalam lvh) dengan isi yang menempel (sticky)
 * selama wrapper discroll. Animasi di dalamnya dikendalikan progress scroll wrapper.
 * Tanpa JavaScript tampil sebagai section biasa.
 */
interface Props {
  id?: string;
  length?: number;
  /** Sticky hanya di desktop (≥1024px); di HP tampil sebagai section biasa. */
  lgOnly?: boolean;
  class?: string;
  trackClass?: string;
  /** Warna latar "world" saat section ini aktif (untuk section transparan). */
  bg?: string;
  [key: `data-${string}`]: string | boolean | undefined;
}

const { id, length = 300, lgOnly = false, class: className, trackClass, bg, ...rest } = Astro.props;
---

<section
  id={id}
  data-sticker
  data-bg={bg}
  data-lg={lgOnly || undefined}
  class:list={['sticker relative', className]}
  style={`--len: ${length}lvh`}
  {...rest}
>
  <div class:list={['sticker-track', trackClass]}>
    <slot />
  </div>
</section>
