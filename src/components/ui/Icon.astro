---
// Kumpulan ikon SVG inline (tanpa library tambahan)
interface Props {
  name: 'whatsapp' | 'instagram' | 'arrow' | 'check' | 'menu' | 'close' | 'plus' | 'cube';
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;
---

