---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { nav, site } from '@/data/site';
import { defaultMessage, waLink } from '@/scripts/utils/whatsapp';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500 ease-out-expo data-[scrolled]:py-0 py-2"
>
  <div class="container-page">
    <nav
      class="mt-3 flex items-center justify-between gap-4 rounded-full px-3 py-2 transition-all duration-500 ease-out-expo in-data-[scrolled]:glass in-data-[scrolled]:bg-brand-blue-950/80 sm:px-4"
      aria-label="Navigasi utama"
    >
      <a
        href={`${base}/`}
        class="flex min-w-0 items-center gap-2.5"
        aria-label={`${site.name} beranda`}
      >
        <img
          src={`${base}/images/brand/logo-mark.png`}
          alt=""
          width="22"
          height="35"
          class="h-8 w-auto"
        />
        <span class="font-display text-lg font-extrabold">{site.name}</span>
      </a>

      <ul class="hidden items-center gap-1 lg:flex">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="rounded-full px-4 py-2 font-display text-sm font-semibold text-white/80 transition hover:bg-white/10 hover:text-white"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex shrink-0 items-center gap-2">
        <!-- Layar ≥640px: tombol berteks. Dibungkus agar `hidden` tidak kalah oleh inline-flex Button. -->
        <div class="hidden sm:block">
          <Button href={waLink(defaultMessage)} external>
            <Icon name="whatsapp" class="size-4" />
            Konsultasi
          </Button>
        </div>
        <!-- HP: ikon WhatsApp bulat saja agar tidak berdesakan dengan logo -->
        <a
          href={waLink(defaultMessage)}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Konsultasi via WhatsApp"
          class="grid size-11 place-items-center rounded-full bg-brand-orange-500 shadow-lg shadow-brand-orange-500/30 transition hover:bg-brand-orange-600 sm:hidden"
        >
          <Icon name="whatsapp" class="size-5" />
        </a>
        <button
          id="menu-toggle"
          type="button"
          class="glass grid size-11 place-items-center rounded-full lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Buka menu"
        >
          <Icon name="menu" class="size-5" />
        </button>
      </div>
    </nav>
  </div>

  <div
    id="mobile-menu"
    hidden
    class="fixed inset-0 z-50 bg-brand-blue-950/95 backdrop-blur-xl lg:hidden"
  >
    <div class="container-page flex h-full flex-col pt-6 pb-10">
      <div class="flex items-center justify-between">
        <span class="font-display text-lg font-extrabold">{site.name}</span>
        <button
          id="menu-close"
          type="button"
          class="glass grid size-11 place-items-center rounded-full"
          aria-label="Tutup menu"
        >
          <Icon name="close" class="size-5" />
        </button>
      </div>
      <ul class="mt-12 flex flex-col gap-2">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="block py-2 font-display text-4xl font-extrabold text-white/90 hover:text-brand-orange-400"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <Button href={waLink(defaultMessage)} external size="lg" class="mt-auto">
        <Icon name="whatsapp" />
        Konsultasi via WhatsApp
      </Button>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const menu = document.getElementById('mobile-menu')!;
  const toggle = document.getElementById('menu-toggle')!;
  const close = document.getElementById('menu-close')!;

  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) close.focus();
  };
  toggle.addEventListener('click', () => setOpen(true));
  close.addEventListener('click', () => setOpen(false));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && !menu.hidden && setOpen(false));
</script>
