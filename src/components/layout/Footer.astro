---
import Icon from '@/components/ui/Icon.astro';
import { nav, site } from '@/data/site';
import { waLink } from '@/scripts/utils/whatsapp';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-brand-blue-950 pt-16 pb-10">
  <div class="container-page grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-3">
        <img
          src={`${base}/images/brand/logo-mark.png`}
          alt=""
          width="26"
          height="41"
          class="h-10 w-auto"
        />
        <span class="font-display text-2xl font-extrabold">{site.name}</span>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/60">{site.description}</p>
    </div>

    <div>
      <h3 class="font-display text-sm font-bold tracking-widest text-white/50 uppercase">Menu</h3>
      <ul class="mt-4 space-y-2.5">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="text-sm text-white/80 hover:text-brand-orange-400">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="font-display text-sm font-bold tracking-widest text-white/50 uppercase">Kontak</h3>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a
            href={waLink()}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 text-white/80 hover:text-brand-orange-400"
          >
            <Icon name="whatsapp" class="size-4" />
            {site.whatsapp.display}
          </a>
        </li>
        <li>
          <a
            href={site.instagram.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 text-white/80 hover:text-brand-orange-400"
          >
            <Icon name="instagram" class="size-4" />@{site.instagram.handle}
          </a>
        </li>
        <li class="text-white/50">{site.location}</li>
      </ul>
    </div>
  </div>

  <div class="container-page mt-14 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-white/40 sm:flex-row sm:justify-between">
    <p>
      © {year} {site.name}. Seluruh hak cipta dilindungi.
    </p>
    <p>Dibuat oleh mahasiswa Pendidikan Multimedia UPI Kampus Cibiru.</p>
  </div>
</footer>
