---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import FloatingWhatsApp from '@/components/layout/FloatingWhatsApp.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} — ${site.tagline}`, description = site.description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/images/brand/logo-512.png`, Astro.site);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#2b95ff" />

    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>
  <body class="overflow-x-clip">
    <a
      href="#main"
      class="sr-only z-[100] rounded-full bg-white px-4 py-2 text-ink focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      Lewati ke konten
    </a>
    <!--
      Lapisan "world" di belakang konten: warna latar yang berganti antar chapter
      dan satu kanvas 3D fixed (scripts/three/world-scene.ts). Terlihat di section transparan.
    -->
    <div id="world-bg" aria-hidden="true" class="fixed inset-0 -z-30 bg-brand-blue-500"></div>
    <canvas
      id="world-canvas"
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 size-full opacity-0 transition-opacity duration-1000"
    ></canvas>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />

    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
